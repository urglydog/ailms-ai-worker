# cp .env.example .env rồi điền giá trị.

# STT — Groq Cloud API (đăng ký key tại console.groq.com, free tier đủ dùng)
ASR_BACKEND=groq
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# LLM — BR-DUB-02 cấm hardcode tên model trong code
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RATE_LIMIT_RPM=12

# TTS — không cần key
EDGE_TTS_REGION=

# Tham số pipeline
CHUNK_MINUTES=10
MAX_RETRY=3
INTERMEDIATE_FILE_TTL_HOURS=24
MAX_RESUMMARIZE_ATTEMPTS=2

# Backblaze B2 — trùng giá trị với be/.env (bí mật hạ tầng dùng chung)
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=

# Giai đoạn 8 — RAG Socratic Tutor
SUPABASE_VECTOR_URL=
SUPABASE_VECTOR_KEY=
