# cp .env.example .env rồi điền giá trị.

# STT — Groq Cloud API (đăng ký key tại console.groq.com, free tier đủ dùng)
ASR_BACKEND=groq
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# LLM — BR-DUB-02 cấm hardcode tên model trong code
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RATE_LIMIT_RPM=12

# TTS — Azure Speech Service, lấy ở Azure Portal > resource Speech service >
# "Keys and endpoint" > KEY 1
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Live Classroom (F11.6/F11.7) — "azure" hoặc "gemini". Đổi giá trị này rồi restart ai-api để
# chuyển provider, không cần build lại code. 2 model Gemini dưới đây chỉ dùng khi provider=gemini
# (xác nhận tồn tại thật qua client.models.list() ngày 01/09/2026).
LIVE_TRANSLATION_PROVIDER=azure
GEMINI_LIVE_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
GEMINI_LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview

# Tham số pipeline
CHUNK_MINUTES=10
MAX_RETRY=3
INTERMEDIATE_FILE_TTL_HOURS=24
MAX_RESUMMARIZE_ATTEMPTS=2

# Proxy dân dụng (residential) cho yt-dlp tải audio YouTube (05/09/2026) — yt-dlp bị chặn khi tải
# thẳng từ IP datacenter/VPS. File KHÔNG commit lên git (secrets/ đã trong .gitignore), tự tạo và
# dán thông tin proxy thật vào — xem secrets/README.md để biết định dạng. Không có file này (mặc
# định) thì tải thẳng như trước, không bắt buộc phải có proxy mới chạy được.
YOUTUBE_PROXY_LIST_PATH=secrets/youtube_proxies.txt

# Backblaze B2 — trùng giá trị với be/.env (bí mật hạ tầng dùng chung)
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=

# Giai đoạn 8 — RAG Socratic Tutor
SUPABASE_VECTOR_URL=
SUPABASE_VECTOR_KEY=
